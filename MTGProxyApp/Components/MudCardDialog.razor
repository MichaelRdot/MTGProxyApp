@using MTGProxyApp.Services
@inject ScryfallService ScryfallService

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">Select your chosen card art.</MudText>

        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
            <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
                <div style="flex:1 1 0;min-width:80px">
                    <FilterPicker Label="Set"
                                  Items="_availableSets"
                                  FormatDisplay="GetSetDisplay"
                                  FilterState="_setFilter"
                                  FilterStateChanged="OnSetFilterChanged" />
                </div>
                <div style="flex:1 1 0;min-width:80px">
                    <FilterPicker Label="Artist"
                                  Items="_availableArtists"
                                  FilterState="_artistFilter"
                                  FilterStateChanged="OnArtistFilterChanged" />
                </div>
                <div style="flex:1 1 0;min-width:80px">
                    <FilterPicker Label="Frame"
                                  Items="_availableFrames"
                                  FormatDisplay="FormatFrameName"
                                  FilterState="_frameFilter"
                                  FilterStateChanged="OnFrameFilterChanged" />
                </div>
                <div style="flex:1 1 0;min-width:80px">
                    <FilterPicker Label="Finish"
                                  Items="_availableFinishes"
                                  FormatDisplay="FormatFinishName"
                                  FilterState="_finishFilter"
                                  FilterStateChanged="OnFinishFilterChanged" />
                </div>
                <div style="flex:1 1 0;min-width:80px">
                    <YearFilterPicker Label="Year"
                                      Items="_availableYears"
                                      FilterState="_yearFilter"
                                      FilterStateChanged="OnYearFilterChanged" />
                </div>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="flex:0 0 auto">
                    <MudSelect T="string"
                               Value="_sortBy" ValueChanged="OnSortByChanged"
                               Dense="true" Margin="Margin.Dense"
                               Style="font-size:0.75rem;min-width:72px">
                        <MudSelectItem T="string" Value="@("released_at")">Date</MudSelectItem>
                        <MudSelectItem T="string" Value="@("artist")">Artist</MudSelectItem>
                    </MudSelect>
                    <MudTooltip Text="@(_sortAscending ? "Ascending" : "Descending")">
                        <MudIconButton Icon="@(_sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                       OnClick="ToggleSortDirection"
                                       Size="Size.Small" />
                    </MudTooltip>
                    <MudTooltip Text="Clear all filters">
                        <MudIconButton Icon="@Icons.Material.Filled.FilterAltOff"
                                       OnClick="ClearAllFilters"
                                       Disabled="!HasActiveFilters"
                                       Size="Size.Small" />
                    </MudTooltip>
                </MudStack>
            </div>

            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.body2" Class="mr-1">Art Tags:</MudText>
                @foreach (var tag in _artTags)
                {
                    <MudChip T="string" Text="@tag" Color="Color.Primary" Size="Size.Small"
                             OnClose="RemoveArtTagChip" />
                }
                @if (_isLoadingTags)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" />
                }
                <MudTextField T="string" Value="_artTagInput" ValueChanged="OnTagValueChanged"
                              Placeholder="@(_artTags.Count == 0 ? "Type a Scryfall art tag and press Enter…" : "Add another tag…")"
                              Variant="Variant.Text" Dense="true" Immediate="true"
                              TextUpdateSuppression="false"
                              OnKeyDown="OnTagInputKeyDown"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Add"
                              OnAdornmentClick="@(_ => AddArtTagAsync())"
                              Style="min-width:180px;flex:1" />
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.caption" Class="mb-2">
            Showing @_cardList.Count of @_allCards.Count prints
        </MudText>

        <MudGrid Spacing="4" Justify="Justify.FlexStart">
            @foreach (var card in _cardList)
            {
                <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="1">
                    <MudCard Outlined="true">
                        <MudCardContent>
                            <MudButton @onclick="@(() => SelectArt(card))">
                                <MudImage Src="@GetImageUrl(card)" Fluid />
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>
