@using MTGProxyApp.Services
@inject ScryfallService ScryfallService

<MudDialog>
    <DialogContent>
        <MudText Class="mb-3">Select your chosen card art.</MudText>

        <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
            <MudGrid Spacing="2" AlignItems="AlignItems.End">
                <MudItem xs="6" sm="3" md="2">
                    <MudSelect T="string" Label="Set" MultiSelection="true" Dense="true"
                               SelectedValues="_selectedSets"
                               SelectedValuesChanged="OnSelectedSetsChanged"
                               Clearable="true">
                        @foreach (var s in _availableSets)
                        {
                            <MudSelectItem T="string" Value="@s">@GetSetDisplay(s)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudSelect T="string" Label="Artist" MultiSelection="true" Dense="true"
                               SelectedValues="_selectedArtists"
                               SelectedValuesChanged="OnSelectedArtistsChanged"
                               Clearable="true">
                        @foreach (var a in _availableArtists)
                        {
                            <MudSelectItem T="string" Value="@a">@a</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudSelect T="string" Label="Frame" MultiSelection="true" Dense="true"
                               SelectedValues="_selectedFrames"
                               SelectedValuesChanged="OnSelectedFramesChanged"
                               Clearable="true">
                        @foreach (var f in _availableFrames)
                        {
                            <MudSelectItem T="string" Value="@f">@FormatFrameName(f)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudSelect T="string" Label="Finish" MultiSelection="true" Dense="true"
                               SelectedValues="_selectedFinishes"
                               SelectedValuesChanged="OnSelectedFinishesChanged"
                               Clearable="true">
                        @foreach (var f in _availableFinishes)
                        {
                            <MudSelectItem T="string" Value="@f">@FormatFinishName(f)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="12" md="4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudSelect T="string" Label="Sort By"
                                   Value="_sortBy" ValueChanged="OnSortByChanged"
                                   Dense="true" Class="flex-grow-1">
                            <MudSelectItem T="string" Value="@("released_at")">Release Date</MudSelectItem>
                            <MudSelectItem T="string" Value="@("artist")">Artist Name</MudSelectItem>
                        </MudSelect>
                        <MudTooltip Text="@(_sortAscending ? "Ascending" : "Descending")">
                            <MudIconButton Icon="@(_sortAscending ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward)"
                                           OnClick="ToggleSortDirection"
                                           Size="Size.Small" />
                        </MudTooltip>
                        <MudButton Variant="Variant.Text"
                                   OnClick="ClearAllFilters"
                                   Disabled="!HasActiveFilters">Clear All</MudButton>
                    </MudStack>
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.body2" Class="mr-1">Art Tags:</MudText>
                @foreach (var tag in _artTags)
                {
                    <MudChip T="string" Text="@tag" Color="Color.Primary" Size="Size.Small"
                             OnClose="RemoveArtTagChip" />
                }
                @if (_isLoadingTags)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-1" />
                }
                <MudTextField @bind-Value="_artTagInput"
                              Placeholder="@(_artTags.Count == 0 ? "Type a Scryfall art tag and press Enter…" : "Add another tag…")"
                              Variant="Variant.Text" Dense="true"
                              OnKeyDown="OnTagInputKeyDown"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Add"
                              OnAdornmentClick="@(_ => AddArtTagAsync())"
                              Style="min-width:180px;flex:1" />
            </MudStack>
        </MudPaper>

        <MudText Typo="Typo.caption" Class="mb-2">
            Showing @_cardList.Count of @_allCards.Count prints
        </MudText>

        <MudGrid Spacing="4" Justify="Justify.FlexStart">
            @foreach (var card in _cardList)
            {
                <MudItem xs="12" sm="6" md="4" lg="3" xl="2" xxl="1">
                    <MudCard Outlined="true">
                        <MudCardContent>
                            <MudButton @onclick="@(() => SelectArt(card))">
                                <MudImage Src="@GetImageUrl(card)" Fluid />
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
    </DialogActions>
</MudDialog>
